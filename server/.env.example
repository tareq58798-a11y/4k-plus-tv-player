DATABASE_URL=postgres://user:password@host:5432/postgres
ADMIN_PASSWORD=choose-a-strong-password
# Optional: enables GET /api/trailer (looks up the real trailer video ID via YouTube Data API v3).
# Create a free key at console.cloud.google.com (enable "YouTube Data API v3"). Free quota is
# 10,000 units/day; each search costs 100, so ~100 unique trailer lookups/day before it starts
# billing or failing - the endpoint caches results in memory to help stay under that.
YOUTUBE_API_KEY=
