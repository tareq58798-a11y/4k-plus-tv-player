<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV has no touchscreen and is driven entirely by a D-pad remote; declaring the
         touchscreen optional (rather than leaving the implicit default of "required") is what
         lets the app appear on TV devices in the Play Store at all. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Marks this build as a proper TV app (shows in the Leanback launcher's app row, gets
         listed under "Android TV" on the Play Store) rather than a phone app side-loaded onto a TV. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <application android:banner="@drawable/tv_banner">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            tools:replace="android:screenOrientation">
            <!-- Additional to (not replacing) the phone app's MAIN/LAUNCHER filter, so the
                 Leanback launcher on TV finds this activity as the app's entry point. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
